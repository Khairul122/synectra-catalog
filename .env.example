# Frontend — public values
NEXT_PUBLIC_APP_URL=https://catalog.synectra.id
NEXT_PUBLIC_API_BASE_URL=https://catalog.synectra.id/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Backend — server-only values
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SIGNED_URL_EXPIRES_IN=86400
DOKU_CLIENT_ID=replace_with_doku_client_id
DOKU_SECRET_KEY=replace_with_doku_secret_key
DOKU_API_BASE_URL=https://api-sandbox.doku.com
RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM_ADDRESS=Synectra Jasa Digital <delivery@example.com>
# Local-only simulators; must be unset/false in production (backend refuses to start otherwise)
DOKU_SIMULATOR=false
RESEND_SIMULATOR=false
